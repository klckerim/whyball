{
  "name": "whyball-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "test": "vitest run",
    "smoke": "npm run build && cd .. && WHYBALL_SMOKE_DIST=web/dist .venv/bin/pytest -q tests/test_smoke_e2e.py",
