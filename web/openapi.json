  "info": {
    "title": "WhyBall",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/health": {
      "get": {
        "operationId": "health_api_health_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "boolean"
                  },
                  "title": "Response Health Api Health Get",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Health"
      }
    },
    "/api/matches": {
      "get": {
        "operationId": "matches_api_matches_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/MatchSummary"
                  },
                  "title": "Response Matches Api Matches Get",
                  "type": "array"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Matches"
      }
    },
    "/api/matches/{match_id}": {
      "get": {
        "operationId": "match_detail_api_matches__match_id__get",
        "parameters": [
          {
            "in": "path",
            "name": "match_id",
            "required": true,
            "schema": {
              "title": "Match Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MatchDetail"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Match Detail"
      }
    },
    "/api/matches/{match_id}/events": {
      "get": {
        "description": "Every event of the stream in order, match_meta (seq 0) included; the stage reads ball positions here.",
        "operationId": "match_events_api_matches__match_id__events_get",
        "parameters": [
          {
            "in": "path",
            "name": "match_id",
            "required": true,
            "schema": {
              "title": "Match Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/TimelineEvent"
                  },
                  "title": "Response Match Events Api Matches  Match Id  Events Get",
                  "type": "array"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Match Events"
      }
    },
    "/api/matches/{match_id}/moments": {
      "get": {
        "operationId": "moments_api_matches__match_id__moments_get",
        "parameters": [
          {
            "in": "path",
            "name": "match_id",
            "required": true,
            "schema": {
              "title": "Match Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/MomentOut"
                  },
                  "title": "Response Moments Api Matches  Match Id  Moments Get",
                  "type": "array"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Moments"
      }
    },
    "/api/matches/{match_id}/replay": {
      "get": {
        "operationId": "match_replay_api_matches__match_id__replay_get",
        "parameters": [
          {
            "in": "path",
            "name": "match_id",
            "required": true,
            "schema": {
              "title": "Match Id",
              "type": "string"
            }
          },
          {
            "description": "match seconds per second; 0 = no wait",
            "in": "query",
            "name": "speed",
            "required": false,
            "schema": {
              "default": 60.0,
              "description": "match seconds per second; 0 = no wait",
              "maximum": 3600.0,
              "minimum": 0,
              "title": "Speed",
              "type": "number"
            }
          },
          {
            "description": "start at this many seconds since kickoff",
            "in": "query",
            "name": "from_t",
            "required": false,
            "schema": {
              "default": 0,
              "description": "start at this many seconds since kickoff",
              "minimum": 0,
              "title": "From T",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Match Replay"
      }
    },
    "/api/matches/{match_id}/series": {
      "get": {
        "operationId": "match_series_api_matches__match_id__series_get",
        "parameters": [
          {
            "in": "path",
            "name": "match_id",
            "required": true,
            "schema": {
              "title": "Match Id",
              "type": "string"
            }
          },
          {
            "description": "metric id with a series: pressure_balance, possession, field_tilt",
            "in": "query",
