**/.env.*
.venv
**/node_modules
.git
.github
.claude
notes
# Offline agent workflow (P2): the service never runs it and the image installs no Agent Framework.
app/agents
data/cache
web/dist
**/__pycache__
*.egg-info
.pytest_cache
**/*.tsbuildinfo
.DS_Store
